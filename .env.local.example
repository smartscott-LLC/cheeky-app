# Club Cheeky — the complete env set. Nothing here is dead weight:
# every variable below is read by the code (verified by grep).
# Vercel auto-provides NEXT_PUBLIC_VERCEL_URL; do not set it manually.

# --- Core site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase (the ONE hosted project; anon key is the only client key) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- The crew's chat engine (DeepSeek) ---
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# --- Owner's back door fallback (the /owner booth, if the owner account check fails) ---
# ADMIN_KEY=

# --- PostHog analytics ---
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry (build-time source-map uploads) ---
SENTRY_AUTH_TOKEN=
# SENTRY_API_KEY=
