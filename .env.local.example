# Club Cheeky — the complete env set. Nothing here is dead weight:
# every variable below is read by the app or its scripts (verified).
# Vercel auto-provides NEXT_PUBLIC_VERCEL_URL; do not set it manually.
#
# env.new is the founder's staging vault (gitignored — never commit it).

# --- Core site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase (the ONE hosted project; anon key is the only client key) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=            # server auth helpers (fallback token minting)

# --- Hosted Postgres (dev scripts only — migrate-hosted, generate-types, tests) ---
POSTGRES_URL=                     # pgbouncer pooler (6543), production path
POSTGRES_URL_NON_POOLING=         # direct (5432), for migrate-hosted
POSTGRES_HOST=

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- The crew's chat engine (DeepSeek) ---
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# --- Owner's back door fallback (the /owner booth, if the owner account check fails) ---
# ADMIN_KEY=

# --- Sentry (build-time source-map uploads) ---
SENTRY_AUTH_TOKEN=
# SENTRY_API_KEY=

# --- The safety watchdog (DateSafe, via OpenRouter) ---
OPENROUTER_API_KEY=
# DATESAFE_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# --- Sentry DSN override (public by design; hardcoded fallback exists) ---
# NEXT_PUBLIC_SENTRY_DSN=

# --- Transactional mail (Resend — welcome, apology, ban notices) ---
RESEND_API_KEY=
REGISTERED_DOMAIN=smartscott.online
